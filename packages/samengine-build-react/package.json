{
  "name": "samengine-build-react",
  "version": "1.9.5",
  "description": "The build adapter for samengine for react in the web.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "node ../../scripts/clean.js && npm run build && npm pack && git push --follow-tags"
